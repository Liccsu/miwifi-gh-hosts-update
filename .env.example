# 复制为 .env 后填写
# cp .env.example .env

# 二选一 (推荐账号模式, token 自动刷新无需人工维护):

# 方式一 (推荐): 小米账号 + 密码, 程序自动登录获取并刷新 access_token
# 注意: 凭据仅保存在本 .env 文件中, 部署到云端容器时请确保其访问权限
MIWIFI_XIAOMI_USER=
MIWIFI_XIAOMI_PASS=

# 方式二: 手动提供 access_token (有效期约 90 天, 过期后需按日志提示更新)
# 获取方法见 README "获取与更新 token"
# MIWIFI_TOKEN=

# 必填: 路由器设备 ID, 来自自定义 Hosts 页面 URL 中的 deviceID 参数
MIWIFI_DEVICE_ID=

# 可选: 应用 ID, 默认即可
# MIWIFI_APP_ID=2882303761517675329

# 可选: 授权 scope, 默认即可
# MIWIFI_SCOPE=1+1000+3

# 可选: token 主动刷新周期 (秒), 默认 5184000 (60 天, 早于 90 天有效期)
# 仅账号模式下生效
# TOKEN_REFRESH_INTERVAL=5184000

# 可选: token 缓存文件路径, 默认 /data/token.json (容器内已挂载卷)
# TOKEN_CACHE_FILE=/data/token.json

# 可选: WebUI 端口, 默认 8571 (docker compose 已映射)
# WEBUI_PORT=8571

# 可选: WebUI 访问 token, 设置后需在 URL 加 ?token= 或请求头 X-Token
# 留空则无鉴权 (仅建议在内网/受信环境使用)
# WEBUI_TOKEN=

# 可选: 设为 1 禁用 WebUI
# WEBUI_DISABLE=

# 可选: 同步间隔 (秒), 默认 21600 (6 小时)
# SYNC_INTERVAL_SECONDS=21600

# 可选: hosts 数据源 URL, 逗号分隔, 按顺序尝试直到成功
# HOSTS_URLS=https://raw.githubusercontent.com/ittuann/GitHub-IP-hosts/main/hosts,https://cdn.jsdelivr.net/gh/ittuann/GitHub-IP-hosts@main/hosts

# 可选: 日志级别 DEBUG/INFO/WARNING/ERROR
# LOG_LEVEL=INFO
